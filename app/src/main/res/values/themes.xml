<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all of the styling; this theme only needs to be edge-to-edge
         friendly and free of an action bar. -->
    <style name="Theme.Inspect3D" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/viewport_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
